{
  "name": "dn-verification-api",
  "version": "1.0.0",
  "description": "API para verificación de distribuidores DN",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build:css && tsx watch src/index.ts",
    "build": "tsc",
    "build:css": "tailwindcss -i ./public/css/main.css -o ./public/css/output.css",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "seed:superadmin": "tsx db/seed-superadmin.ts",
    "migrate:campanas": "tsx db/migrate-campanas-to-db.ts",
    "init:tenant-db": "psql -U postgres -d $0 -f db/init-tenant-db.sql"
  },
  "keywords": [
    "dn",
    "verification",
    "distribuidores"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "autoprefixer": "^10.4.27",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.21.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  }
}
