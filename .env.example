API_KEY_QA=tu_api_key_qa_aqui
API_KEY_PROD=tu_api_key_prod_aqui
PORT=3000

# Environment
NODE_ENV=development

# CORS (opcional)
# CORS_ORIGIN=http://localhost:4200
