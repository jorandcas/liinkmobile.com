# ============================================
# VARIABLES DE ENTORNO - DN Verification API v2.0.0
# ============================================
# Copia este archivo a .env y configura los valores
# No commits .env al repositorio (ya está en .gitignore)

# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# BASE DE DATOS POSTGRESQL (SuperAdmin)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=bd_superadmin

# ============================================
# SEGURIDAD Y ENCRIPTACIÓN
# ============================================
# Clave para encriptar API Keys de tenants (AES-256-GCM)
# Genera una clave segura de 32 caracteres o más
# Ejemplo: openssl rand -base64 32
ENCRYPTION_KEY=your_32_character_or_longer_encryption_key_here

# Secreto para firmar tokens JWT
# Genera una clave segura aleatoria
# Ejemplo: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_min_32_characters

# Expiración del token JWT (ej: 24h, 7d, 30d)
JWT_EXPIRATION=24h

# ============================================
# POLÍTICAS DE SEGURIDAD
# ============================================
# Mínima longitud de contraseña para usuarios
PASSWORD_MIN_LENGTH=8

# Máximo número de intentos fallidos de login antes de bloquear
MAX_LOGIN_ATTEMPTS=5

# Tiempo de bloqueo en segundos (ej: 900 = 15 minutos)
ACCOUNT_LOCK_TIME=900

# ============================================
# CORS
# ============================================
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=https://liinkmobile.com,https://www.liinkmobile.com

# ============================================
# VALIDACIÓN DE API KEY (opcional)
# ============================================
# Teléfono de prueba para validar API Keys
# No usar números reales de clientes
VALIDATION_TEST_PHONE=7773354612

# ============================================
# LEGACY - Ya no se usan, se mantienen por compatibilidad
# ============================================
# API_KEY=tu_api_key_aqui
# API_KEY_QA=tu_api_key_qa_aqui
# API_KEY_PROD=tu_api_key_prod_aqui
